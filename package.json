{
  "name": "frotzlens-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "test": "pnpm -r --filter \"./packages/*\" run test",
    "typecheck": "pnpm -r --filter \"./packages/*\" run typecheck",
    "samples": "pnpm --filter @frotzinc/inform6-wasm build && node scripts/build-samples.mjs"
  },
  "devDependencies": {
    "@frotzinc/inform6-wasm": "workspace:*",
    "@types/node": "^22.20.5",
    "typescript": "5.9.3",
    "vitest": "^5.1.0"
  }
}

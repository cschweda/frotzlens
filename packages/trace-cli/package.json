{
  "name": "frotztrace",
  "version": "0.0.2",
  "private": true,
  "description": "A debugger for Z-machine story files, on the command line: play a script under observation, trace every call, and stop on a routine with its stack. The CLI of frotztrace.",
  "license": "GPL-3.0-or-later",
  "author": "Christopher Schweda",
  "type": "module",
  "homepage": "https://frotztrace.frotzinc.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cschweda/frotzlens.git",
    "directory": "packages/trace-cli"
  },
  "bugs": {
    "url": "https://github.com/cschweda/frotzlens/issues"
  },
  "bin": {
    "frotztrace": "dist/bin.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/bin.js",
    "test": "pnpm run build && vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@frotzinc/zcode": "workspace:*",
    "@frotzinc/zmachine": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "5.9.3",
    "vitest": "^5.1.0"
  },
  "keywords": [
    "z-machine",
    "interactive-fiction",
    "debugger",
    "inform",
    "inform6",
    "frotzinc"
  ]
}

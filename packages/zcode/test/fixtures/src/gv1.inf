! ============================================================================
!  GRAMMAR VERSION 1  —  Frotzlens test fixture
! ----------------------------------------------------------------------------
!  Inform's older grammar table format (Grammar__Version 1: 8-byte lines, a
!  preposition table, a parsing-routine table), with no library: the Standard
!  Library 6.12 always uses version 2, whatever this constant says. Four
!  verbs, prepositions, synonyms, a general parsing routine, and noun= and
!  scope= routines (which share its table). Copyright
!  Christopher Schweda; MIT, as part of @frotzinc/zcode's tests.
! ============================================================================

Constant Grammar__Version 1;

Attribute light;

Object Hall "Hall" with name 'hall', has light;
Object -> Lamp "brass lamp" with name 'brass' 'lamp';

[ Main; @quit; ];

[ TakeSub; rtrue; ];
[ DropSub; rtrue; ];
[ PutSub; rtrue; ];
[ LookSub; rtrue; ];
[ ParseNoun; return -1; ];
[ IsLamp; rtrue; ];
[ LampScope; rfalse; ];

Verb 'take' 'get'
  * noun        -> Take
  * 'off' noun  -> Drop;

Verb 'drop'
  * noun            -> Drop
  * noun 'in' noun  -> Put
  * noun 'on' noun  -> Put;

Verb 'look' 'l'
  *              -> Look
  * 'at' noun    -> Look
  * ParseNoun    -> Look;

! noun=Routine and scope=Routine: GV1 indexes them in the same parsing-routine table.
Verb 'rub'
  * noun=IsLamp        -> Take
  * scope=LampScope    -> Look;

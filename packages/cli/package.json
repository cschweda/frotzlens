{
  "name": "frotzlens",
  "version": "0.2.0",
  "description": "Inspect Z-machine story files from the terminal: the disassembly as Ztools' txd prints it, every infodump section, names from Inform's debug file, what made the story, its map, or the whole model as JSON. The CLI of Frotzlens.",
  "license": "GPL-3.0-or-later",
  "author": "Christopher Schweda",
  "type": "module",
  "homepage": "https://frotzlens.frotzinc.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cschweda/frotzlens.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/cschweda/frotzlens/issues"
  },
  "bin": {
    "frotzlens": "dist/bin.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/bin.js",
    "test": "pnpm run build && vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@frotzinc/zcode": "workspace:*"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "^5.1.0",
    "@types/node": "^22.20.5"
  },
  "keywords": [
    "z-machine",
    "z-code",
    "zcode",
    "inform",
    "inform6",
    "interactive-fiction",
    "disassembler",
    "txd",
    "infodump",
    "frotz",
    "frotzsmith",
    "zil",
    "blorb"
  ]
}
